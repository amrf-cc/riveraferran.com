<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; frame-src https://livid.com; connect-src https://formspree.io; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; upgrade-insecure-requests">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="robots" content="noai, noimageai">
<title>${CLIENT} — ${NAME}</title>
<meta name="description" content="${DESCRIPTION}">
<meta property="og:type" content="article">
<meta property="og:url" content="${OG_URL}">
<meta property="og:title" content="${CLIENT} — ${NAME}">
<meta property="og:description" content="${DESCRIPTION}">
<meta property="og:image" content="${OG_IMAGE}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:image" content="${OG_IMAGE}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#f7f5f0">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%23E2401C'/><text x='50' y='54' font-family='Georgia,serif' font-size='62' fill='%23fff' text-anchor='middle' dominant-baseline='middle'>A</text></svg>">
<link rel="preload" as="font" type="font/woff2" href="${ROOT_PREFIX}assets/fonts/fraunces-latin.woff2" crossorigin>
<link rel="stylesheet" href="${ROOT_PREFIX}assets/css/fonts.css">
<link rel="stylesheet" href="${ROOT_PREFIX}assets/css/styles.css">
</head>
<body>
${NAV}
<main>
<div class="wrap project-head">
  <a class="backlink" href="${ROOT_PREFIX}gallery.html">← All projects</a>
  <p class="kicker" style="margin-top:24px">${CLIENT}</p>
  <h1>${PTITLE}</h1>
  <p class="facts">${FACTS}</p>
  <p class="desc">${DESCRIPTION}</p>
</div>
<section style="padding-top:40px">
  <div class="wrap">
${VIDEO_SECTION}
${PHOTO_SECTION}
  </div>
</section>
<section>
  <div class="wrap">
    <div class="sec-head" style="margin-bottom:0">
      <div>
        <span class="kicker">Next</span>
        <h2>Like what you see?</h2>
      </div>
      <p class="lede"><a class="link-arrow" href="${ROOT_PREFIX}contact.html">Start a project</a></p>
    </div>
  </div>
</section>
</main>
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" aria-hidden="true">
  <button type="button" class="lb-btn lb-close" aria-label="Close viewer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  <button type="button" class="lb-btn lb-prev" aria-label="Previous photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8"/></svg></button>
  <figure class="lb-stage">
    <img src="" alt="" draggable="false">
    <figcaption class="lb-cap"><span class="lb-count"></span><span class="lb-alt"></span></figcaption>
  </figure>
  <button type="button" class="lb-btn lb-next" aria-label="Next photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8"/></svg></button>
</div>
${FOOTER}
