    <form class="contact" id="contact-form" data-endpoint="${FORMSPREE_ENDPOINT}" data-email="${EMAIL}" action="#" method="POST"${MSG_ATTRS}>
      <label for="cf-name">${LABEL_NAME}</label>
      <input id="cf-name" type="text" name="name" required autocomplete="name">
      <label for="cf-email">${LABEL_EMAIL}</label>
      <input id="cf-email" type="email" name="email" required autocomplete="email">
      <label for="cf-message">${LABEL_MESSAGE}</label>
      <textarea id="cf-message" name="message" required></textarea>
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off">
      <input type="hidden" name="_subject" value="${SUBJECT}">
      <p class="form-note">${FORM_NOTE}</p>
      <button type="submit">${FORM_SUBMIT}</button>
      <p class="form-status" role="status"></p>
    </form>
